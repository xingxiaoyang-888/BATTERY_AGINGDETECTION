# Environment reference; export values in your shell before starting the API.
SODIUM_DATA_DIR=data/workspace
SODIUM_MODEL_DIR=artifacts
# OPENMODELICA_BIN=C:/Program Files/OpenModelica/bin
# OPENMODELICAHOME=C:/Program Files/OpenModelica
# SODIUM_THERMAL_MODEL=/absolute/path/to/trusted/compatible/model.pkl
# SODIUM_LIFETIME_FEATURE_PATH=/absolute/path/to/audited/sodium/features.parquet
# SODIUM_ADMIN_USER=admin
# Provision a unique password through your environment, never through Git.
# SODIUM_API_KEY=<generate at least 32 random ASCII characters; never commit the value>
# SODIUM_ALLOWED_HOSTS=localhost,127.0.0.1,::1
# SODIUM_DEV_MODE=1
# Legacy registration and pickle loading are disabled unless explicitly enabled.
# SODIUM_ALLOW_REGISTRATION=1
# SODIUM_TRUST_LEGACY_ARTIFACTS=1
